# Streamlit Cloud Secrets Template
# In Streamlit Community Cloud: Go to App Settings -> Secrets, and paste your values below:

# Required: Google Gemini API Key
GEMINI_API_KEY = "your_gemini_api_key_here"

# Optional: If you deployed FastAPI backend externally (e.g., on Render or Railway):
# BACKEND_URL = "https://your-agentrag-backend.onrender.com"

# Optional: If you connect to an external hosted MySQL database (e.g., Aiven or TiDB):
# MYSQL_HOST = "your-mysql-host.aivencloud.com"
# MYSQL_PORT = 3306
# MYSQL_DATABASE = "agentrag_db"
# MYSQL_USER = "avnadmin"
# MYSQL_PASSWORD = "your_password"
